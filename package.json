{
  "name": "medraui",
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "projects/medra/ui",
    "projects/site"
  ],
  "scripts": {
    "ng": "ng",
    "start": "npm run build:css:showcase && ng serve showcase",
    "build:ui": "ng build @medra.dev/ui",
    "build:css": "tailwindcss -i ./projects/medra/ui/src/styles/entry.css -o ./dist/medra/ui/styles.css --minify",
    "build:css:showcase": "tailwindcss -i ./projects/showcase/src/styles/entry.css -o ./dist/showcase/styles.css --minify",
    "build": "npm run build:ui && npm run build:css",
    "build:showcase": "npm run build:css:showcase && ng build showcase",
    "dev:site": "npm run -w projects/site dev",
    "build:site": "npm run -w projects/site build",
    "watch": "ng build @medra.dev/ui --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e": "playwright test",
    "generate:icons": "node projects/medra/ui/tools/generate-icons.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "node tools/release/publish.mjs",
    "release:check": "node tools/release/check.mjs policy"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.23",
    "@angular/cli": "21.2.23",
    "@angular/compiler-cli": "21.2.25",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/cli": "^4.3.2",
    "@testing-library/angular": "^19.4.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^30.0.0",
    "heroicons": "^2.2.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-preset-angular": "^17.0.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
