{
  "name": "site",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "ng": "ng",
    "generate:api-docs": "tsx tools/generate-api-docs.mts",
    "generate:search-index": "tsx tools/generate-search-index.mts",
    "predev": "npm run build:ui --prefix ../.. && npm run generate:api-docs && npm run generate:search-index",
    "dev": "vite",
    "start": "npm run dev",
    "prebuild": "npm run build:ui --prefix ../.. && npm run generate:api-docs && npm run generate:search-index",
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest",
    "preview": "serve dist/analog/public"
  },
  "private": true,
  "dependencies": {
    "@analogjs/content": "^2.7.1",
    "@analogjs/router": "^2.7.1",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.25",
    "@angular/router": "^21.2.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "front-matter": "^4.0.2",
    "marked": "^15.0.7",
    "marked-gfm-heading-id": "^4.1.1",
    "marked-highlight": "^2.2.1",
    "marked-mangle": "^1.1.10",
    "postcss": "^8.5.3",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.7.1",
    "@analogjs/vite-plugin-angular": "^2.7.1",
    "@analogjs/vitest-angular": "^2.7.1",
    "@angular/build": "^21.2.18",
    "@angular/cli": "^21.2.18",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^22.0.0",
    "serve": "^14.2.6",
    "tsx": "^4.23.13",
    "typescript": "~5.9.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "$vitest"
  }
}
